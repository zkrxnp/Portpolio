# MongoDB 연결 문자열. Atlas라면 Connect → Drivers에서 복사하고 .net/ 뒤에 DB 이름을 넣습니다.
# 개발과 운영은 DB를 나누세요: 여기(.env.local)는 로컬/개발 DB, 운영 주소는 Vercel 환경 변수에만.
# 로컬이면 mongodb://127.0.0.1:27017/jiwoo-portfolio
MONGODB_URI=""

# 세션 서명 키 (JWT 서명에 쓰입니다).
#
# 손으로 치지 마세요. 추측 가능하면 공격자가 관리자 세션 토큰을 위조해서
# 로그인 자체를 건너뜁니다. 코드는 길이만 검사하고 엔트로피는 못 봅니다.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# 이 값을 바꾸면 발급된 모든 세션이 즉시 만료됩니다 (유출 시 대응 수단).
AUTH_SECRET=""

# ── GitHub OAuth ───────────────────────────────────────────────
# github.com/settings/developers → New OAuth App 에서 만듭니다.
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/github/callback
# OAuth 앱은 콜백 URL을 하나만 받습니다. 운영용 앱을 따로 만들어 운영 콜백을 등록하세요.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# 들어올 수 있는 GitHub 계정의 **숫자 ID**. 쉼표로 여러 개.
# 본인 ID 확인:
#   curl -s https://api.github.com/users/본인아이디 | findstr "\"id\""
#
# 사용자명이 아니라 ID로 거는 이유: 사용자명은 바꿀 수 있고, 계정을 지우면
# 남이 그 이름을 다시 가져갈 수 있습니다.
ADMIN_GITHUB_IDS=""

# ID를 못 구했을 때만 쓰는 임시 대안. 위를 채웠다면 비워두세요.
ADMIN_GITHUB_LOGIN=""

# 메타데이터 절대 URL 생성용 (배포 후 실제 도메인으로)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
